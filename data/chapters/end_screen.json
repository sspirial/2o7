    {
      "node_id": "recap_matatu_listen",
      "speaker": null,
      "text": "On Msafiri, you listened. You watched the city argue about a future it didn't understand yet. Sometimes silence says more than noise.",
      "text_sw": null,
      "gloss": null,
      "expression": null,
      "choices": null,
      "next": "end_recap_kiosk"
    },
    {
      "node_id": "recap_matatu_join",
      "speaker": null,
      "text": "On Msafiri, you spoke up. You jumped into the debate and held your ground. In a city of loud voices, yours found its place.",
      "text_sw": null,
      "gloss": null,
      "expression": null,
      "choices": null,
      "next": "end_recap_kiosk"
    },
    {
      "node_id": "recap_matatu_quiet",
      "speaker": null,
      "text": "On Msafiri, you chose your own world. Earphones in, city out. Not every moment needs your voice — some just need your eyes.",
      "text_sw": null,
      "gloss": null,
      "expression": null,
      "choices": null,
      "next": "end_recap_kiosk"
    },
    {
      "node_id": "end_recap_kiosk",
      "speaker": null,
      "text": "[SYSTEM: RECAP kiosk_choice]",
